# JARVIS Environment Variables (Template)
# Copy this to .env and fill in your actual values. NEVER commit .env!

# Instagram Credentials (Session cookie preferred over password to avoid checkpoints)
INSTAGRAM_USERNAME=
INSTAGRAM_SESSION_ID=

# AI API Keys (Optional, fallback LLM classification / MCP queries)
# Uses local whisper.cpp by default for transcription (free)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
